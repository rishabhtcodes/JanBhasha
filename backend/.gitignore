# Dependencies
/vendor
/node_modules

# Environment files
.env
.env.backup
.env.*
!.env.example

# Laravel generated / cache
/bootstrap/cache/*.php
!bootstrap/cache/.gitkeep
/storage/*.key
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/logs/*.log
/storage/app/public/*
!storage/app/public/.gitkeep

# Vite / Frontend build
/public/build
/public/hot
/public/storage
/.vite/

# PHPUnit
/.phpunit.cache
/.phpunit.result.cache
phpunit.xml.bak

# Composer
# composer.lock is intentionally committed for apps (not libraries)

# IDE / Editor
/.idea
/.vscode
/.fleet
/.zed
*.swp
*.swo
.editorconfig.bak

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Docker / Deployment secrets
docker-compose.override.yml

# Logs
*.log
